{
  "name": "tonight",
  "version": "0.1.0",
  "private": true,
  "description": "Tonight: live free-bed board for Berlin night shelters",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "seed:firestore": "node scripts/seed-firestore.js",
    "deploy:firebase": "firebase deploy --only hosting,firestore:rules",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tonight \"node --test test-rules/*.test.js\"",
    "emulators": "firebase emulators:start --only auth,firestore,hosting --project gen-lang-client-0099418772",
    "set-admin": "node scripts/set-admin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.1"
  }
}
