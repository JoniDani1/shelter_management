{
  "hosting": {
    "site": "tonight-berlin",
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "redirects": [{ "source": "/", "destination": "/board/", "type": 302 }],
    "headers": [
      { "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
